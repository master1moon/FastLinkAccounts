<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvPartnerPercentageWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFEBEE"
        android:padding="8dp"
        android:textColor="@color/danger_red"
        android:textStyle="bold"
        android:visibility="gone"
        android:text="⚠️ تنبيه: مجموع نسب الشركاء لا يساوي 100%" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <Button
            android:id="@+id/btnAddPartner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ إضافة شريك" />

        <Button
            android:id="@+id/btnPartnerDateRange"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="المدة الزمنية" />

        <Button
            android:id="@+id/btnExportPartnersPdf"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="PDF" />

        <Button
            android:id="@+id/btnExportPartnersExcel"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Excel" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPartnersOverallSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#E8F5E9"
        android:padding="10dp"
        android:textSize="13sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPartners"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="6dp" />
</LinearLayout>
